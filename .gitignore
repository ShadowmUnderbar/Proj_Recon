# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
.uloop

# Playtest runner reports (rotated locally, not for source control)
/Tools/Playtest/Reports/

# Sheets CLI（認証キー・依存パッケージはコミット禁止）
Tools/Sheets/service-account.json
Tools/Sheets/node_modules/
Tools/Sheets/package-lock.json

# 実行時セーブデータ（SaveDataStoreがApplication.dataPath配下に書き出す。ソース管理対象外）
/Assets/DLHN/
/Assets/DLHN.meta
.cursor/mcp.json
.mcp.json

# Blenderファイル（.blend）はリポジトリのどこでも追跡しない。原本はGit外で保管する
*.blend
*.blend1
# Art（Blender作業ディレクトリ）
# 参考画像などは追跡しない
Art/**/*.jpg
Art/**/__pycache__/
# 確認用のプレビュー画像と実行ログ（生成スクリプトから作り直せるため追跡しない）
Art/**/Renders/
Art/**/*.log
# 参考資料（キャラクターシートの切り抜きなど）
Art/**/Reference/
# 書き出し結果（FBX・テクスチャ）。Blenderの原本やスクリプトから再生成でき、Unityへ取り込んだ後はAssets側で管理する
Art/**/Export/
.codex/config.toml
